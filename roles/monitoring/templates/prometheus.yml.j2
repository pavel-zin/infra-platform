# Managed by Ansible
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["{{ monitoring_wg_ip }}:9090"]

  - job_name: node
    static_configs:
      - targets:
          - 10.66.0.1:9100
          - 10.66.0.2:9100

  - job_name: cadvisor
    static_configs:
      - targets:
          - 10.66.0.1:8080
          - 10.66.0.2:8080

  - job_name: gatus
    static_configs:
      - targets:
          - 10.66.0.1:8081
