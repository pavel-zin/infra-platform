# Managed by Ansible
# The image's stock nginx.conf, plus the SNI router when web_tls_passthrough
# lists any hostname.
user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log notice;
pid        /run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;

    keepalive_timeout  65;
{% if web_tls_passthrough | length > 0 %}

    # HTTPS arrives through the SNI router below, which prepends a PROXY
    # protocol header: restore the real client address from it.
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    # The HTTPS vhosts listen on 8443 behind the router; keep that port out
    # of the Location headers nginx builds (e.g. /img -> /img/).
    port_in_redirect off;
{% endif %}

    include /etc/nginx/conf.d/*.conf;
}
{% if web_tls_passthrough | length > 0 %}

# SNI router. Hostnames in web_tls_passthrough terminate TLS themselves (they
# read the raw handshake); every other name goes to nginx's own HTTPS
# listener. Only the server name in the ClientHello is inspected here.
stream {
    # Docker's embedded DNS, queried per connection, so nginx starts and
    # reloads even while a passthrough backend is down.
    resolver 127.0.0.11 valid=10s ipv6=off;

    map $ssl_preread_server_name $web_tls_upstream {
        hostnames;
{% for p in web_tls_passthrough %}
        {{ p.server_name }}    {{ p.upstream }};
{% endfor %}
        default    127.0.0.1:8443;
    }

    server {
        listen 443;
        ssl_preread on;
        proxy_pass $web_tls_upstream;
        proxy_protocol on;
        proxy_connect_timeout 5s;
    }
}
{% endif %}
