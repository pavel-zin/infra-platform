# Managed by Ansible
storage:
  type: sqlite
  path: /data/data.db

metrics: true

ui:
  title: "{{ domain }} — status"
  header: "{{ domain }} — service status"

endpoints:
  - name: main
    group: public
    url: https://{{ domain }}
    interval: 60s
    conditions:
      - "[STATUS] == 200"

  - name: wp demo
    group: public
    url: https://blog.{{ domain }}
    interval: 60s
    conditions:
      - "[STATUS] == 200"
{% for p in web_tls_passthrough %}

  - name: {{ p.name }}
    group: public
    url: https://{{ p.server_name }}{{ p.health_path | default('/') }}
    interval: 60s
    conditions:
      - "[STATUS] == 200"
      - "[CERTIFICATE_EXPIRATION] > 240h"
{% endfor %}

  - name: internal network (WireGuard)
    group: internal
    url: icmp://10.66.0.2
    interval: 60s
    conditions:
      - "[CONNECTED] == true"

  - name: database
    group: internal
    url: tcp://10.66.0.2:3306
    interval: 60s
    conditions:
      - "[CONNECTED] == true"
